# Supabase — powers /admin and the articles shown on /blog.
# Both values are in your Supabase project under Settings -> API.
#
# This file is COMMITTED TO GIT and must only ever hold placeholders.
# Put the real values in .env.local (gitignored), which is what Vite reads.
# Add the same two variables in Vercel -> Settings -> Environment Variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
